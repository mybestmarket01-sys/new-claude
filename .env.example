# Clé API Anthropic — active la recherche web live et la rédaction par Claude.
# Sans clé, l'application tourne en mode hors ligne : tout est produit à partir
# de la base intégrée (41 sources fournisseurs, 45 produits, modèle économique COD).
ANTHROPIC_API_KEY=

# Modèle utilisé par l'orchestrateur (défaut : claude-opus-5)
POSTE_COD_MODEL=claude-opus-5

# Port du serveur local (défaut : 4321)
PORT=4321
