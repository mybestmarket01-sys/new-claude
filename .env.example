# ---------------------------------------------------------------------------
# Claude — active la recherche web live et la rédaction en darija.
# Sans clé, l'application tourne en mode hors ligne : tout est produit à partir
# de la base intégrée (41 sources fournisseurs, 45 produits, modèle COD).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
POSTE_COD_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Make — pousse les campagnes terminées et les commandes vers vos scénarios.
# Le webhook suffit : créez un scénario démarrant par « Webhooks → Custom
# webhook » et collez son URL. Le jeton d'API est facultatif, il sert
# uniquement à lister et déclencher vos scénarios depuis l'atelier.
# ---------------------------------------------------------------------------
MAKE_WEBHOOK_URL=
MAKE_API_TOKEN=
MAKE_ZONE=eu2
MAKE_TEAM_ID=

# ---------------------------------------------------------------------------
# Higgsfield — une photo produit par angle, en plus des neuf créas SVG.
# Deux valeurs obligatoires : identifiant de clé et secret.
# HIGGSFIELD_PROFIL : v2 (api.higgsfield.ai, courant) ou v1
# (platform.higgsfield.ai, en-têtes hf-api-key / hf-secret).
# ---------------------------------------------------------------------------
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_PROFIL=v2
HIGGSFIELD_MODEL=higgsfield-ai/soul/v2/standard

# ---------------------------------------------------------------------------
# Serveur local
# ---------------------------------------------------------------------------
PORT=4321
